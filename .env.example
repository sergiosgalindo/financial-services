# Database Configuration (SQLite default or PostgreSQL connection string)
DATABASE_URL=sqlite:///./fintech.db

# LLM Configuration (Local Ollama or Groq Cloud)
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3.1:8b
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Semantic RAG Configuration
EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Two-Layer Defense in Depth
ENABLE_REMOTE_LLAMA_GUARD=false
LLAMA_GUARD_MODEL=meta-llama/llama-guard-4-12b

# Meta WhatsApp Cloud API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=verify-token-123
WHATSAPP_API_VERSION=v22.0
NGROK_AUTHTOKEN=
